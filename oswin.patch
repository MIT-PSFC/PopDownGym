+    with open(pkl_path, "rb") as f:
+        dict_processed: dict[str, dict[str, tuple[np.ndarray, np.ndarray]]] = pickle.load(f)
+
+    # C_vals: (n_constr, )
+    # C_data: (n_constr, [mean, q05, q95], [val, ci_lo, ci_hi] )
+    # C_vals, C_data = dict_processed["li"]
+    envparam_labels = list(dict_processed.keys())
+    n_envparam = len(envparam_labels)
+    assert n_envparam == 7
+    n_rows, n_cols = 2, 4
+
+    figsize = 0.8 * np.array([n_cols * 3, n_rows * 2])
