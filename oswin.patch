+        act="tanh",
+        pol_type="TanhNormal",
+        train_cfg=None,
+        rew_scale=5e2,
+        clip_grad=1.0,
+    )
+    ppo = PPOAlg.create(jr.PRNGKey(0), env, ppo_cfg)
+
+    root_dir = pathlib.Path(__file__).parent.parent.parent
